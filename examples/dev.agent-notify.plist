<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- LaunchAgent for agent-notify. Install to ~/Library/LaunchAgents/ and run:
	     launchctl bootstrap gui/$UID ~/Library/LaunchAgents/dev.agent-notify.plist
	     Replace the paths and the focus bundle id with yours. The first
	     argument is the app a banner CLICK brings forward — your terminal
	     (e.g. com.mitchellh.ghostty, com.googlecode.iterm2,
	     com.todesktop.230313mzl4w4u92 for Cursor, com.apple.Terminal).
	     The binary must run from inside AgentNotify.app — the bundle is the
	     daemon's notification identity (see examples/AgentNotify-Info.plist). -->
	<key>Label</key>
	<string>dev.agent-notify</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/YOU/.agent-notify/AgentNotify.app/Contents/MacOS/agent-notify</string>
		<string>com.mitchellh.ghostty</string>
		<string>/Users/YOU/.agent-notify.sock</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardErrorPath</key>
	<string>/Users/YOU/.agent-notify/daemon.log</string>
</dict>
</plist>
